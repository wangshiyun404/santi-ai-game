  {
   "id": "clue_reply",
   "subtitle": "不要回答！不要回答！！不要回答！！！",
   "narration": "vo_00_do_not_answer.wav",
   "story": "——这是四光年外三体世界的一个监听员发来的警告：只要回答，地球的位置就会暴露。"
  },
  {
   "id": "clue_antenna",
   "subtitle": "红岸基地，1971 年。",
   "narration": "vo_00_redcoast.wav",
   "story": "——这座天线曾把你的信号对准太阳，太阳把它放大上亿倍，射向了宇宙。"
  },
  {
   "id": "clue_control_room",
   "subtitle": "发射。",
   "narration": "vo_00_transmit.wav",
   "final": true,
   "story": "——你看着这个让你绝望的世界，按下了发射键。白光之后，你将看见你召唤来的，是怎样一个文明。",
   "endingSubtitle": "我点燃了火，却控制不了它。",
   "endingStory": "——叶文洁的这个选择，是整个《三体》故事的开端。游戏到此结束。"
  }
 ],
 "events": [
  {
   "id": "transmit_whiteout",
   "trigger": "clue_control_room",
   "duration": 3,
   "loadScene": "scene_01_chaotic"
  }
 ],
 "intro": {
  "title": "第一幕 · 红岸基地 · 1971",
  "lines": "你是叶文洁，红岸基地的技术员。\n八年前，你用太阳当天线，把地球的坐标发向了宇宙。今夜，回复到了。\n先去看看回复说了什么，再决定要不要按下发射键。",
  "objective": "看吉普车旁的电台和天线塔，最后到主控室做决定"
 },
 "ending": {
  "title": "尾声 · 红岸基地 · 1971",
  "lines": "你看见了：那是一个在三颗太阳之间挣扎了 191 次的文明。\n他们会来。而发射键，还在你手边。\n回到主控室，结束这段旅程。",
  "objective": "回到主控室",
  "endText": "你按下了发射键，也看见了后果。\n一个人的绝望，把两个世界连在了一起——这就是《三体》第一部的开端。\n\n第一幕：做选择　第二幕：看他们怎么活　第三幕：看他们怎么算　尾声：回到按键前\n\n按 R 重新开始\n\n教学用非官方同人改编 · 原著 © 刘慈欣"
 }
